import 'package:client/module.dart';
import 'package:client/services.dart';
import 'package:managed/managed.dart';

Future<void> main() async {
  final plain = Settings();
  final generated = SettingsProvider.provider();
  final explicit =
      SettingsProvider.provider(SettingsParams(label: null, stamp: null));
  if (generated.label != plain.label ||
      generated.stamp != plain.stamp ||
      generated.read() != plain.read() ||
      explicit.label != null ||
      explicit.stamp != null) {
    throw StateError('Constructor defaults or explicit null changed');
  }
  final slots = SlotsProvider.of<int, int>()(SlotsParams<int, int>(
    left: SlotParams<int>(value: 1),
    right: SlotParams<int>(value: 2),
  ));
  if (slots.left.value != 1 || slots.right.value != 2) {
    throw StateError('Generic constructor arguments were mixed');
  }
  final session = AccountSessionProvider.provider;
  final user =
      Manage(() => Manage.resolve<AccountSession>().user, dependsOn: [session]);
  final cache = AccountCacheProvider.register(dependsOn: [user]);
  final editor = EditorProvider.register(dependsOn: [cache]);
  await session().update(Account(1, 'Alice'));
  final open = editor();
  await session().update(null);
  if (open.cache.starts != 1 || open.cache.stops != 1 || open.stops != 1) {
    throw StateError('Generated lifecycle hooks did not run once per instance');
  }
}
